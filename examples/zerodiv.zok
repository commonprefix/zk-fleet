def inverse(field c) -> field {
    return 1 / c;
}
def main(
    field nonZeroVariable
) {
    field x = if nonZeroVariable == 0 {
        0
    } else {
        // the assertion `nonZeroVariable != 0` does not hold here!
        // Run `zokrates compute-witness -a 0` to see what happens.
        inverse(nonZeroVariable)
    };
}

